<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds a field (MoveModel) version of a Pokemon battle model with SPICA's H3D reader/writer.
       SPICA is compiled from a local checkout (tools/SPICA, not versioned here). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS0618;CS0649;CS0169;CS0414;CS0168;CA1416;SYSLIB0011</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../tools/SPICA/SPICA/**/*.cs" Exclude="../../../tools/SPICA/SPICA/obj/**;../../../tools/SPICA/SPICA/bin/**" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>
