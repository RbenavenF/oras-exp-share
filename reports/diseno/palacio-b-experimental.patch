+PMEM, PSTACK, PRETURN = 0x08000000, 0x09001000, 0x0A000000
+PMAIN, PCLIENT, PSETUP, PWORK, PGAME, PSAVE = (PMEM + n for n in (0x1000, 0x2000, 0x3000, 0x4000, 0x5000, 0x10000))
